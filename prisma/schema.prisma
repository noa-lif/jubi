generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categories {
  id           Int            @id @default(autoincrement())
  user_id      Int?
  name         String         @db.VarChar(100)
  users        users?         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  transactions transactions[]

  @@unique([user_id, name], map: "uq_category_user_name")
  @@index([id], map: "ix_categories_id")
  @@index([user_id], map: "ix_categories_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model file_imports {
  id                Int      @id @default(autoincrement())
  user_id           Int
  file_hash         String   @db.VarChar(64)
  filename          String   @db.VarChar(255)
  uploaded_at       DateTime @db.Timestamp(6)
  transaction_count Int
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, file_hash], map: "uq_file_import_user_hash")
  @@index([id], map: "ix_file_imports_id")
  @@index([user_id], map: "ix_file_imports_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model password_reset_tokens {
  id         Int      @id @default(autoincrement())
  user_id    Int
  token      String   @unique(map: "ix_password_reset_tokens_token") @db.VarChar(64)
  expires_at DateTime @db.Timestamp(6)
  used       Boolean
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([id], map: "ix_password_reset_tokens_id")
  @@index([user_id], map: "ix_password_reset_tokens_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model transactions {
  id            Int         @id @default(autoincrement())
  user_id       Int
  date          DateTime    @db.Date
  amount        Float
  business_name String      @db.VarChar(255)
  category_id   Int?
  categories    categories? @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([date], map: "ix_transactions_date")
  @@index([id], map: "ix_transactions_id")
  @@index([user_id], map: "ix_transactions_user_id")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                    Int                     @id @default(autoincrement())
  email                 String                  @unique(map: "ix_users_email") @db.VarChar(255)
  password_hash         String                  @db.VarChar(255)
  id_number             String                  @unique @db.VarChar(50)
  categories            categories[]
  file_imports          file_imports[]
  password_reset_tokens password_reset_tokens[]
  transactions          transactions[]

  @@index([id], map: "ix_users_id")
}
