# Copy this file to .env.local and fill in real values.
# .env.local and .env are both gitignored — never commit real secrets.

# ---------------------------------------------------------------------------
# Database — Supabase Postgres
# ---------------------------------------------------------------------------
# Both come from the Supabase dashboard:
#   Project Settings -> Database -> Connection string -> URI
#
# DATABASE_URL is what the app uses at runtime. Use the connection *pooler*
# host: serverless functions on Vercel open a connection per invocation, and
# the pooler is what keeps that from exhausting Postgres' connection limit.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# DIRECT_URL is used by the Prisma CLI for migrations only. Migrations issue
# DDL and need a session-mode connection, which a transaction-mode pooler
# cannot provide.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Secret used to sign session JWTs (HS256). Must be a long random string —
# anyone who knows it can mint a token for any account. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The app refuses to start if this is missing.
JWT_SECRET="generate-a-long-random-string-do-not-use-this-value"

# How long a session token stays valid. Accepts zeit/ms style durations
# ("7d", "24h", "30m"). Optional — defaults to "7d".
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Testing (optional — only needed to run the database test suite)
# ---------------------------------------------------------------------------
# Same server and credentials as DIRECT_URL, but with a ?schema= qualifier
# pointing at a schema used only by tests. The suite TRUNCATEs every table
# between tests, so this must never point at the app's schema.
#
# Set it up once with:  npm run db:migrate:test
# Without it, `npm test` skips the database tests and runs the rest.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require&schema=jubi_test"
