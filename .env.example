# Copy this file to .env.local and fill in real values. Never commit real
# secrets — .env.local and .env are both gitignored.

# Supabase Postgres connection strings (see Supabase project settings ->
# Database -> Connection string). DATABASE_URL is the pooled connection used
# at runtime; DIRECT_URL is the direct connection used by Prisma CLI for
# introspection/migrations.
DATABASE_URL="postgresql://user:password@host:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/postgres?sslmode=require"

# Long random string used to sign JWTs — same role as the old SECRET_KEY.
JWT_SECRET="change-me-in-production-use-a-long-random-string"
# Token lifetime, e.g. "7d", "24h". Same default as the old
# ACCESS_TOKEN_EXPIRE_MINUTES=10080 (7 days).
JWT_EXPIRES_IN="7d"
